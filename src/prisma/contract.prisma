// use prisma-next
enum Role {
  BUYER
  EXPORTER
  ADMIN
  VERIFICATION_OFFICER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      Role     @default(BUYER)
  passwordHash String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
